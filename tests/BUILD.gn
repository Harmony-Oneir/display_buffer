# oneir/display_buffer: тесты производительности аллокатора.
# Сборка:  ./oneir/make.sh //oneir/display_buffer/test:display_buffer_perf
# Зависимости повторяют unit-тест аллокатора
# (drivers/peripheral/display/buffer/test/unittest/BUILD.gn) — при ошибках сверяться с ним.

import("//build/ohos.gni")

ohos_executable("display_buffer_perf") {
  testonly = true
  sources = [ "perf/display_buffer_perf.cpp" ]
  include_dirs = [ "//drivers/interface/display/composer/hdifd_parcelable" ]
  external_deps = [
    "c_utils:utils",
    "drivers_interface_display:display_buffer_idl_headers",
    "drivers_interface_display:display_composer_idl_headers",
    "drivers_interface_display:libdisplay_buffer_hdi_impl",
    "graphic_surface:buffer_handle",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]
  install_enable = false
  part_name = "oneir_display"
  subsystem_name = "oneir"
}
