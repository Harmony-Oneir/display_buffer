{
  "name": "@oneir/display_buffer",
  "description": "Display Buffer VDI (allocator) for OpenHarmony on x86_64 PC",
  "version": "1.0.0",
  "license": "Apache License 2.0",
  "publishAs": "code-segment",
  "segment": {
    "destPath": "oneir/display_buffer"
  },
  "dirs": {},
  "scripts": {},
  "component": {
    "name": "oneir_display",
    "subsystem": "oneir",
    "syscap": [],
    "features": [],
    "adapted_system_type": [ "standard" ],
    "rom": "",
    "ram": "",
    "deps": {
      "components": [
        "c_utils",
        "drivers_interface_display",
        "graphic_surface",
        "hdf_core",
        "hilog",
        "ipc"
      ],
      "third_party": [
        "libdrm"
      ]
    },
    "build": {
      "sub_component": [
        "//oneir/display_buffer:display_buffer"
      ],
      "inner_kits": [
        {
          "name": "//oneir/display_buffer:oneir_drm_select",
          "header": {
            "header_files": [
              "oneir_drm_select.h"
            ],
            "header_base": "//oneir/display_buffer/include"
          }
        },
        {
          "name": "//oneir/display_buffer:oneir_display_buffer_vdi_impl",
          "header": {
            "header_files": [
              "display_buffer_vdi_impl.h"
            ],
            "header_base": "//oneir/display_buffer/src/display_gralloc"
          }
        }
      ],
      "test": [
        "//oneir/display_buffer/tests:display_buffer_perf"
      ]
    }
  }
}
